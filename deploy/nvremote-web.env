# Settings for nvremote-web-gateway.service. Install as /etc/nvremote-web.env.
NVR_LISTEN_HOST=127.0.0.1
NVR_LISTEN_PORT=39870
NVR_ALLOWED_ORIGINS=https://nvremote.mad-gamer.com
# Names that mean the NVDA Remote relay on this machine (NVDARemoteServer on port 6837).
NVR_LOCAL_RELAY_HOSTS=mad-gamer.com,nvremote.mad-gamer.com
NVR_LOCAL_RELAY_ADDRESS=127.0.0.1
NVR_LOCAL_RELAY_PORT=6837
NVR_MAX_SESSIONS_PER_IP=6
NVR_MAX_CONNECTS_PER_MINUTE=30
NVR_MAX_TOTAL_SESSIONS=300
